# ============================================================
# Auralis Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-jwt>

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── App ──────────────────────────────────────────────────────
APP_ENV=development

# ── Production only ──────────────────────────────────────────
PRODUCTION_FRONTEND_URL=https://your-domain.com

# ── Email (password reset) ───────────────────────────────────
# SMTP credentials for sending password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@auralis.ai
# URL of the frontend — appended to reset links
FRONTEND_URL=https://your-domain.com
